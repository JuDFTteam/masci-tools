   </xsd:complexType>

   <xsd:complexType name="RelaxStepType">
     <xsd:sequence>
       <xsd:element maxOccurs="unbounded" minOccurs="1"  name="posforce" type="FleurDouble6DVecType" />
     </xsd:sequence>
      <xsd:attribute name="energy" type="FleurDouble"/>
   </xsd:complexType>


   <xsd:complexType name="ForcetheoremType">
      <xsd:annotation>
         <xsd:documentation>
            Force theorem calculations for magnetic properties.
            
            Fundamental approach:
            - Use converged charge density from single reference calculation
            - Estimate energy changes by comparing eigenvalue sums (not full SCF)
            - Much faster than multiple self-consistent calculations
            - Valid only for small perturbations from reference state
            
            Workflow:
            1. Prepare reference system and converge charge density
            2. Add forceTheorem section after output element
            3. Run Fleur; force theorem calculation executes after SCF loop
            4. Results written to out.xml with eigenvalue sums
            
            Reference state selection:
            - Critical for reliability of results
            - Should be compatible with all force theorem configurations
            - Symmetries must not clash with force theorem parameters
            - Carefully investigate reference state dependence
            - Test applicability by checking result sensitivity
            
            Available modes:
            
            MAE (Magnetic Anisotropy Energy):
            - Compare eigenvalue sums for different magnetization directions
            - Requires collinear reference state
            - Does NOT include shape anisotropy contributions
            - Specify theta/phi angle lists (must have equal length)
            - Results in Forcetheorem_MAE section with ev-sum per angle
            
            Spin-spiral Dispersion:
            - Eigenvalue sums for series of q-vectors
            - First q-vector should match reference state q-value
            - Maps out spin-spiral energy landscape
            
            DMI (Dzyaloshinskii-Moriya Interaction):
            - Estimates SOC effect on spin-spirals via perturbation theory
            - Incompatible with generalized Bloch theorem used in spin-spirals
            - Uses first-order perturbation theory for SOC
            - Combination of MAE and spin-spiral modes
            - Requires spav=T in input file
            - Evaluates multiple angle/q-vector combinations
            
            Jij (Heisenberg Exchange):
            - Determines pairwise exchange coupling constants
            - Starting from collinear state, tilts pairs of magnetic atoms
            - Superimposes spin-spiral for each pair
            - Can generate large number of calculations: N ≤ (M_atoms)²·(N_q + 1)
            - Specify thetaj (tilt angle) and q-vector list
            
            See Lezaic et al. (FZ Jülich thesis) for theoretical details.
         </xsd:documentation>
      </xsd:annotation>
     <xsd:choice>
       <xsd:element name="MAE" type="MAEType">
          <xsd:annotation>
             <xsd:documentation>
                Magnetic anisotropy energy calculation over specified angles.
                Compares eigenvalue sums for different magnetization orientations.
                Requires collinear reference state. Output in Forcetheorem_MAE section.
             </xsd:documentation>
          </xsd:annotation>
       </xsd:element>
       <xsd:element name="spinSpiralDispersion" type="QListType">
          <xsd:annotation>
             <xsd:documentation>
                Spin spiral dispersion calculation for specified q-vectors.
                First q-vector should correspond to reference state.
                Maps energy landscape of spin-spiral configurations.
             </xsd:documentation>
          </xsd:annotation>
       </xsd:element>
       <xsd:element name="DMI" type="DMIType">
          <xsd:annotation>
             <xsd:documentation>
                Dzyaloshinskii-Moriya interaction calculation.
                Uses perturbation theory to estimate SOC effects on spin-spirals.
                Requires spav=T. Combines angle and q-vector specifications.
             </xsd:documentation>
          </xsd:annotation>
       </xsd:element>
       <xsd:element name="DMI-SCF" type="DMISCFType">
          <xsd:annotation>
             <xsd:documentation>Self-consistent DMI calculation.</xsd:documentation>
          </xsd:annotation>
       </xsd:element>
       <xsd:element name="Jij" type="JijType">
          <xsd:annotation>
             <xsd:documentation>
                Heisenberg exchange coupling Jij calculation.
                Evaluates energies for spin-spiral states with tilted magnetic atoms.
                Can produce large number of calculations: up to (M_atoms)²·(N_q+1).
             </xsd:documentation>
          </xsd:annotation>
       </xsd:element>
     </xsd:choice>
   </xsd:complexType>

   <xsd:complexType name="MAEType">
      <xsd:annotation>
         <xsd:documentation>Magnetic anisotropy energy calculation parameters.</xsd:documentation>
      </xsd:annotation>
     <xsd:attribute name="theta" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>List of polar angles theta for MAE calculation (radians).</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="phi" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>List of azimuthal angles phi for MAE calculation (radians).</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="DMIType">
      <xsd:annotation>
         <xsd:documentation>Dzyaloshinskii-Moriya interaction calculation parameters.</xsd:documentation>
      </xsd:annotation>
     <xsd:all>
       <xsd:element  maxOccurs="1" minOccurs="1" name="qVectors" type="QListType">
          <xsd:annotation>
             <xsd:documentation>List of q-vectors for DMI calculation.</xsd:documentation>
          </xsd:annotation>
       </xsd:element>
     </xsd:all>
     <xsd:attribute name="theta" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>Polar angles for DMI calculation.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="phi" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>Azimuthal angles for DMI calculation.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="ef_shift" type="FleurDoubleVecType" use="optional">
        <xsd:annotation>
           <xsd:documentation>Fermi energy shifts for energy-resolved DMI.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="DMISCFType">
      <xsd:annotation>
         <xsd:documentation>Self-consistent DMI calculation parameters.</xsd:documentation>
      </xsd:annotation>
     <xsd:attribute name="theta" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>Polar angles for self-consistent DMI calculation.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="phi" type="FleurDoubleVecType" use="required">
        <xsd:annotation>
           <xsd:documentation>Azimuthal angles for self-consistent DMI calculation.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="ef_shift" type="FleurDoubleVecType" use="optional">
        <xsd:annotation>
           <xsd:documentation>Fermi energy shifts for energy-resolved DMI.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="JijType">
      <xsd:annotation>
         <xsd:documentation>Heisenberg exchange coupling Jij calculation parameters.</xsd:documentation>
      </xsd:annotation>
     <xsd:all>
       <xsd:element  maxOccurs="1" minOccurs="1" name="qVectors" type="QListType">
          <xsd:annotation>
             <xsd:documentation>List of q-vectors for Jij calculation.</xsd:documentation>
          </xsd:annotation>
       </xsd:element>
     </xsd:all>
     <xsd:attribute name="thetaj" type="FleurDouble" use="required">
        <xsd:annotation>
           <xsd:documentation>Cone angle for Jij calculation (radians).</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="QListType">
      <xsd:annotation>
         <xsd:documentation>List of q-vectors for spin spiral or force theorem calculations.</xsd:documentation>
      </xsd:annotation>
     <xsd:sequence>
       <xsd:element maxOccurs="unbounded" minOccurs="1"  name="q" type="FleurDouble3DVecType">
          <xsd:annotation>
             <xsd:documentation>Individual q-vector in reciprocal lattice units.</xsd:documentation>
          </xsd:annotation>
       </xsd:element>
     </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="UnfoldingBandType">
      <xsd:annotation>
         <xsd:documentation>
            Band unfolding settings for supercell calculations.
            
            Band unfolding maps supercell band structure back to primitive cell,
            making it easier to interpret results from defect or surface calculations.
            See Rubel et al., PRB 90, 115202 (2014) for theoretical background.
            
            Requirements:
            - output/@band=T must be set (band structure calculation)
            - Number of k-points must be multiple of MPI threads
            - Self-consistent charge density from supercell calculation
            
            Usage modes:
            1. Simple supercell (supercellX/Y/Z only):
               - Specify integer multiples of primitive cell dimensions
               - K-point path given for primitive cell (auto-adapted if ratios match)
               - Example: 4×4×4 supercell with single defect
            
            2. Rotated supercell (with transMat):
               - Provide full transformation matrix (integer entries)
               - Useful for surfaces with non-trivial surface cells
               - K-point path must be given in supercell coordinates
               - Matrix multiplied from right: (a1,a2,a3) × transMat = supercell basis
               - Example: √3×√3 rotation of hexagonal lattice
            
            Special cases:
            - Film systems: Use with primCellZ inpgen flag for vacuum adjustment
            - SOC (l_soc=T): Set useOlap=F for second variation eigenfunctions
            - Z-direction only: Can combine with transMat for efficient surface cells
            
            Output files:
            - band_sc.1, band_sc.2: Backfolded band structure data
            - band_sc.gp: Gnuplot script for visualization
            - banddos.hdf: HDF5 with weights for advanced analysis
            
            Visualization:
            - Backfolded bands shown with weights indicating spectral function
            - Supercell bands appear faint in background
            - Defect states clearly visible in band gap regions
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="transMat" type="Matrix3Type">
            <xsd:annotation>
               <xsd:documentation>
                  Transformation matrix from primitive to supercell (3×3, integer entries).
                  Multiplied from right to primitive basis vectors.
                  Required for rotated supercells. If omitted, simple scaling used.
                  Note: K-path must be given in supercell coordinates when using transMat.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="unfoldBand" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Enable band unfolding calculation.
               Produces both supercell and backfolded (primitive cell) band structures.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="supercellX" type="xsd:positiveInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Supercell size in x-direction (multiple of primitive cell).
               Set to 1 if using only transMat for transformation.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="supercellY" type="xsd:positiveInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Supercell size in y-direction (multiple of primitive cell).
               Set to 1 if using only transMat for transformation.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="supercellZ" type="xsd:positiveInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Supercell size in z-direction (multiple of primitive cell).
               For films: use primCellZ inpgen flag to ensure correct vacuum multiples.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="T" name="useOlap" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Use overlap matrix for calculating unfolding weights.
               Must set to F when using with spin-orbit coupling (l_soc=T),
               as second variation wavefunctions are used in that case.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="JuPhonType">
      <xsd:annotation>
         <xsd:documentation>JuPhon interface for phonon and electron-phonon calculations using DFPT.</xsd:documentation>
      </xsd:annotation>
      <xsd:all>
         <xsd:element  maxOccurs="1" minOccurs="1" name="qVectors" type="QListType">
            <xsd:annotation>
               <xsd:documentation>List of phonon q-vectors.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:all>
      <xsd:attribute name="l_dfpt" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable DFPT (density functional perturbation theory) calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_jpCheck" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable JuPhon consistency checks.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <!--xsd:attribute name="l_jpTest" type="FleurBool" use="optional"/-->
      <!--xsd:attribute name="l_potout" type="FleurBool" use="optional"/-->
      <!--xsd:attribute name="l_eigout" type="FleurBool" use="optional"/-->
      <xsd:attribute name="eDiffcut" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Energy difference cutoff for state selection.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="fDiffcut" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Occupation difference cutoff for state selection.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="qlim" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Q-vector magnitude limit.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>  
      <xsd:attribute name="gmaxzLocal" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Local Gmax for z-direction (film calculations).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>  
      <xsd:attribute name="l_intp" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable interpolation of phonon properties.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_band" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate phonon band structure.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_dos" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate phonon DOS.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_scf" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable self-consistent DFPT calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_elph" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate electron-phonon coupling.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_sumrule" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Apply acoustic sum rule correction.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_rm_qhdf" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Remove existing q.hdf files before calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="startq" type="xsd:positiveInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Starting q-point index for parallel calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="stopq" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Stopping q-point index for parallel calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="qmode" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Q-point mode selection.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="i_integration" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Integration method for electron-phonon coupling.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="smearingGauss" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Gaussian smearing width for integration.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_phonon" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable phonon calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_efield" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Include (bare) electric field perturbation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_efield_scr" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Include screened electric field perturbation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_borneffcharge" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate Born effective charges.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_polar" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate Born effective charges.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_symVacLevel" type="FleurBool" use="optional" default="F">
         <xsd:annotation>
            <xsd:documentation>Symmetrize vacuum level for film calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="OutputType">
      <xsd:annotation>
         <xsd:documentation>
            Optional output section for parameters controlling special output generation
            such as DOS, band structures, plots, and spectroscopy calculations.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:all>
         <xsd:element maxOccurs="1" minOccurs="0" name="checks" type="ChecksType">
            <xsd:annotation>
               <xsd:documentation>Switches for various diagnostic checks.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="bandDOS" type="DOSOutputType">
            <xsd:annotation>
               <xsd:documentation>Parameters for density of states calculations.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="vacuumDOS" type="VacDOSType">
            <xsd:annotation>
               <xsd:documentation>Parameters for vacuum DOS calculations (films).</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="plotting" type="PlottingType">
            <xsd:annotation>
               <xsd:documentation>Parameters for charge density and potential plotting.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="chargeDensitySlicing" type="ChargeDensitySlicingType">
            <xsd:annotation>
               <xsd:documentation>Parameters for charge density slicing output.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="specialOutput" type="SpecialOutputType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="coreSpectrum" type="CoreSpecOutputType">
            <xsd:annotation>
               <xsd:documentation>Parameters for core-level spectroscopy calculations.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="wannier" type="WannierOutputType">
            <xsd:annotation>
               <xsd:documentation>Parameters for Wannier function generation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="magneticCircularDichroism" type="MagneticCircularDichroismType">
            <xsd:annotation>
               <xsd:documentation>Parameters for MCD calculations.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="unfoldingBand" type="UnfoldingBandType">
            <xsd:annotation>
               <xsd:documentation>Parameters for band unfolding from supercell to primitive cell.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="juPhon" type="JuPhonType">
            <xsd:annotation>
               <xsd:documentation>Parameters for phonon calculations using DFPT.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:all>
      <xsd:attribute default="F" name="dos" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Calculate density of states (DOS).
               
               Requires self-consistent charge density. Configure DOS parameters
               in bandDOS element (energy range, broadening, projections).
               
               Key considerations:
               - Match sigma to k-point density for smooth, physical DOS
               - Consider tetrahedron method (bzIntegration/@mode="tria") as alternative
               - Output in LOCAL.1 (LOCAL.2 for spin-polarized) and banddos.hdf
               - Check Fermi energy with: grep FermiEnergy out.xml
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="band" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Perform band structure calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="slice" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Calculate charge density slice.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="coreSpec" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="wannier" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="eig66" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="ElectronConfigType">
      <xsd:annotation>
         <xsd:documentation>Electron configuration specifying core and valence states for an atom species.</xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="coreConfig" type="CoreStateListType">
            <xsd:annotation>
               <xsd:documentation>List of core states (e.g., "[He]", "[Ar]", or individual states like "1s 2s 2p").</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="valenceConfig" type="ValenceStateListType">
            <xsd:annotation>
               <xsd:documentation>List of valence states (e.g., "(3s 3p 3d 4s)").</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="stateOccupation" type="ElectronStateOccupationType">
            <xsd:annotation>
               <xsd:documentation>Custom occupation numbers for specific states.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute default="F" name="flipSpins" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Flip spin ordering for antiferromagnetic initialization.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:simpleType name="ValenceStateListType">
      <xsd:annotation>
         <xsd:documentation>List of valence electron states (e.g., "3s 3p 3d 4s").</xsd:documentation>
      </xsd:annotation>
      <xsd:list itemType="ElectronStateEnum"/>
   </xsd:simpleType>

   <xsd:simpleType name="CoreStateListType">
      <xsd:annotation>
         <xsd:documentation>List of core electron states or noble gas configuration shorthand.</xsd:documentation>
      </xsd:annotation>
      <xsd:list itemType="CoreConfigEnum"/>
   </xsd:simpleType>

   <xsd:complexType name="ElectronStateOccupationType">
      <xsd:annotation>
         <xsd:documentation>Custom occupation for a specific electron state.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="state" type="ElectronStateEnum" use="required">
         <xsd:annotation>
            <xsd:documentation>Electron state name (e.g., "3d", "4s").</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="spinUp" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Spin-up occupation (number of electrons).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="spinDown" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Spin-down occupation (number of electrons).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:simpleType name="CoreSpecEdgeEnum">
      <xsd:annotation>
         <xsd:documentation>X-ray absorption edge type: K (1s), L (2s/2p), M (3s/3p/3d), N, O, P.</xsd:documentation>
      </xsd:annotation>
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="K"/>
         <xsd:enumeration value="L"/>
         <xsd:enumeration value="M"/>
         <xsd:enumeration value="N"/>
         <xsd:enumeration value="O"/>
         <xsd:enumeration value="P"/>
      </xsd:restriction>
   </xsd:simpleType>


   <xsd:simpleType name="MixingEnum">
      <xsd:annotation>
         <xsd:documentation>SCF density mixing algorithms: straight (simple), Broyden1/2 (quasi-Newton), Anderson, Pulay/rPulay/pPulay/aPulay (DIIS variants).</xsd:documentation>
      </xsd:annotation>
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="straight"/>
         <xsd:enumeration value="Broyden1"/>
         <xsd:enumeration value="Broyden2"/>
         <xsd:enumeration value="Anderson"/>
         <xsd:enumeration value="Pulay"/>
         <xsd:enumeration value="rPulay"/>
         <xsd:enumeration value="pPulay"/>
         <xsd:enumeration value="aPulay"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="ForceMixEnum">
      <xsd:annotation>
         <xsd:documentation>Geometry optimization algorithms: straight (steepest descent), CG (conjugate gradient), BFGS (quasi-Newton).</xsd:documentation>
      </xsd:annotation>
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="straight"/>
         <xsd:enumeration value="CG"/>
         <xsd:enumeration value="BFGS"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="BZIntegrationModeEnum">
      <xsd:annotation>
         <xsd:documentation>Brillouin zone integration methods: hist (histogram), gauss (Gaussian smearing), tria/tetra (tetrahedron method).</xsd:documentation>
      </xsd:annotation>
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="hist"/>
         <xsd:enumeration value="gauss"/>
         <xsd:enumeration value="tria"/>
         <xsd:enumeration value="tetra"/>
      </xsd:restriction>
   </xsd:simpleType>


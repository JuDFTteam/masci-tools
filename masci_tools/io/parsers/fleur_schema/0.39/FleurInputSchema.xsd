   <xsd:complexType name="ChargeDensitySlicingType">
      <xsd:annotation>
         <xsd:documentation>Parameters for energy-resolved charge density slicing.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="numkpt" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Number of k-points for slicing calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="minEigenval" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Minimum eigenvalue for slicing window (Hartree).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="maxEigenval" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Maximum eigenvalue for slicing window (Hartree).</xsd:documentation>

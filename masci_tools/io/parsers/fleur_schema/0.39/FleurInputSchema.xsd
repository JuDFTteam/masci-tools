<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="0.39">

   <xsd:element name="fleurInput" type="FleurInputType">
      <xsd:annotation>
         <xsd:documentation>
            Root element for FLEUR input files (inp.xml). Contains all input parameters
            for the FLEUR FLAPW code. The file is typically produced by the input generator
            'inpgen' but can be manually edited for workflow adjustments.
         </xsd:documentation>
      </xsd:annotation>
   </xsd:element>

   <xsd:complexType name="FleurInputType">
      <xsd:annotation>
         <xsd:documentation>
            Main container type for all FLEUR input sections. The input file consists of
            several sections: comment, constants, calculationSetup, cell, atomSpecies,
            atomGroups, output, forceTheorem, relaxation, and ldaV.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:all>
         <xsd:element maxOccurs="1" minOccurs="0" name="comment" type="xsd:string">
            <xsd:annotation>
               <xsd:documentation>
                  Optional comment section. Encloses a simple line of text that is
                  written out as part of the inp.xml into the out.xml file.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="constants" type="ConstDefGroupType">
            <xsd:annotation>
               <xsd:documentation>
                  Optional constants section for defining named constants that can be used
                  in other parts of the input file, e.g., lattice setup or atom positions.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="calculationSetup" type="CalculationSetupType">
            <xsd:annotation>
               <xsd:documentation>
                  Calculation setup section covering general numerical parameters controlling
                  the FLEUR calculation, including cutoffs, SCF loop settings, magnetism, etc.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="cell" type="CellType">
            <xsd:annotation>
               <xsd:documentation>
                  Cell section covering k-points, symmetry operations, and lattice vectors.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="atomSpecies" type="AtomSpeciesType">
            <xsd:annotation>
               <xsd:documentation>
                  Atom species section defining numerical parameters for different atom types.
                  Each species has a unique name and is associated with atom groups.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="atomGroups" type="AtomGroupsType">
            <xsd:annotation>
               <xsd:documentation>
                  Atom groups section containing groups of symmetry equivalent atoms.
                  Each atom group is associated with a species and contains atom positions.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="output" type="OutputType">
            <xsd:annotation>
               <xsd:documentation>
                  Optional output section for parameters controlling special output like
                  DOS calculations, band structures, plotting, etc.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
	       <xsd:element maxOccurs="1" minOccurs="0" name="forceTheorem" type="ForcetheoremType">
            <xsd:annotation>
               <xsd:documentation>
                  Optional force theorem section for efficient approximative calculations
                  of magnetocrystalline anisotropy energy (MAE), spin-spiral dispersions,
                  Dzyaloshinskii-Moriya interaction (DMI), and Heisenberg exchange (Jij).
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
	       <xsd:element maxOccurs="1" minOccurs="0" name="relaxation" type="RelaxationType">
            <xsd:annotation>
               <xsd:documentation>
                  Relaxation section containing atom displacements and relaxation history
                  for geometry optimization calculations. Typically included via XInclude
                  from relax.xml file.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ldaV" type="LdaVType"/>
      </xsd:all>
      <xsd:attribute name="fleurInputVersion" type="FleurVersionType" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Version number of the input file format.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:simpleType name="FleurVersionType">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="0.39"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="ConstDefGroupType">
      <xsd:annotation>
         <xsd:documentation>
            Container for constant definitions that can be referenced in other parts
            of the input file using their names.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="constant" type="ConstantDefinitionType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="ConstantDefinitionType">
      <xsd:annotation>
         <xsd:documentation>
            Defines a named constant with a value that can be used in expressions
            elsewhere in the input file.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="name" type="xsd:string">
         <xsd:annotation>
            <xsd:documentation>Name of the constant for reference in expressions.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="value" type="xsd:string">
         <xsd:annotation>
            <xsd:documentation>Numeric value of the constant.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="CalculationSetupType">
      <xsd:annotation>
         <xsd:documentation>
            Calculation setup section covering general numerical parameters controlling
            the FLEUR calculation including cutoffs, SCF iteration settings, core electrons,
            exchange-correlation functional, magnetism, spin-orbit coupling, and more.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:all>
         <xsd:element name="cutoffs" type="CutoffsType">
            <xsd:annotation>
               <xsd:documentation>Main cutoff parameters for the LAPW calculation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="scfLoop" type="SCFLoopType">
            <xsd:annotation>
               <xsd:documentation>Parameters controlling SCF loop iterations and mixing scheme.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="coreElectrons" type="CoreElectronsType">
            <xsd:annotation>
               <xsd:documentation>Parameters for the treatment of core electrons.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="xcFunctional" type="XCFunctionalType">
            <xsd:annotation>
               <xsd:documentation>Exchange-correlation functional specification.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="magnetism" type="MagnetismType">
            <xsd:annotation>
               <xsd:documentation>Parameters controlling magnetic calculations (collinear and non-collinear).</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="prodBasis" type="ProdBasisIRType">
            <xsd:annotation>
               <xsd:documentation>Product basis parameters for hybrid functional calculations.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="soc" type="SOCType">
            <xsd:annotation>
               <xsd:documentation>Spin-orbit coupling parameters.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="expertModes" type="ExpertModeType">
            <xsd:annotation>
               <xsd:documentation>Advanced calculation modes including GW output and second variation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="geometryOptimization" type="GeometryOptimizerType">
            <xsd:annotation>
               <xsd:documentation>Parameters for force calculations and structural optimization.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ldaU" type="LdaUGeneralType">
            <xsd:annotation>
               <xsd:documentation>
                  General LDA+U parameters for density matrix mixing.
                  
                  Controls self-consistent iteration of (2l+1)×(2l+1) density matrices
                  for each spin and U parameter. The density matrix determines additional
                  Hamiltonian contributions from U parameters defined in atomSpecies.
                  
                  Key files:
                  - n_mmp_mat_out: Written each iteration with current density matrices
                  - n_mmp_mat: Optional input for density matrix starting point
                  - out.xml: Contains densityMatrixFor sections with all matrices
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ldaHIA" type="LdaHIAGeneralType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="greensFunction" type="GFGeneralType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="rdmft" type="RDMFTType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="spinSpiralQPointMesh" type="SpinSpiralQPointMeshType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="fields" type="FieldType">
            <xsd:annotation>
               <xsd:documentation>
                  External electric and magnetic field configuration.
                  
                  Magnetic fields: Applied as Zeeman terms, can be global (b_field) or
                  per-species (b_field_mt in atomSpecies/special element).
                  
                  Electric fields: For films, created by charge sheets in vacuum.
                  Requires charge neutrality adjustments in bzIntegration/@valenceElectrons.
                  Supports homogeneous (sig_b_1/2) and inhomogeneous (shape elements) distributions.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:all>
   </xsd:complexType>


   <xsd:complexType name="FieldType">
      <xsd:annotation>
         <xsd:documentation>
            Configuration for external electric and magnetic fields.
            
            Magnetic fields:
            - Can be applied to the whole unit cell via b_field attribute
            - The implementation adds Zeeman terms to the potential
            - Fields are not included in density-potential integrals for total energy
            - Supported in both film and bulk setups
            
            Electric fields:
            - For films: Place sheets of charge on either side of the film in vacuum
            - Generates electric field perpendicular to film surface
            - Requires charge neutrality: added charge must be subtracted from valenceElectrons
            - Alternative: Add/subtract fractional charge via valenceElectrons attribute
            
            Shape elements:
            - Create inhomogeneous charge distributions using rect, circ, rectSinX, polygon, datafile
            - Syntax examples:
              rect &lt;sheet&gt; &lt;x&gt;,&lt;y&gt; &lt;width&gt;,&lt;height&gt; &lt;charge&gt; [options]
              circ &lt;sheet&gt; &lt;x&gt;,&lt;y&gt; &lt;radius&gt; &lt;charge&gt; [options]
            - Positions and lengths are relative values (0 to 1)
            - Sheet can be: top, bot, or topbot/bottop
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
       <xsd:element maxOccurs="unbounded" minOccurs="0"  name="shape" type="xsd:string">
         <xsd:annotation>
            <xsd:documentation>
               String specification for inhomogeneous charge distributions.
               Supported syntax: rect, circ, rectSinX, polygon, datafile.
               Example: "rect top 0,0 0.5,1.0 0.2" creates rectangular charge on top sheet.
            </xsd:documentation>
         </xsd:annotation>
       </xsd:element>
     </xsd:sequence>
      <xsd:attribute default="0.0" name="b_field" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Magnetic field applied to whole unit cell (simple Zeeman term).
               Note: Only affects MT spheres, not included in total energy integrals.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="10.0" name="zsigma" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Position of charge sheets relative to vacuum boundary in atomic units.
               Default is 10 a.u. (≈ 5.29 Å). Only relevant for electric fields in films.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="sig_b_1" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Charge on upper plate for electric field generation.
               Enables asymmetric field when sig_b_1 ≠ sig_b_2.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="sig_b_2" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Charge on lower plate for electric field generation.
               Enables asymmetric field when sig_b_1 ≠ sig_b_2.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="plot_charge" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="plot_rho" type="FleurBool" use="optional"/>
      <xsd:attribute default="T" name="autocomp" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Automatic compensation for charge neutrality.
               When true, excess charge of film is automatically balanced by charge sheets.
               When false, user must manually ensure overall charge neutrality.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="dirichlet" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Enable Dirichlet boundary conditions for electric field calculations.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="eV" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Modify units when dirichlet=true.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>



   <xsd:complexType name="MTNocoParamsType">
      <xsd:annotation>
         <xsd:documentation>
            Muffin-tin non-collinear magnetism parameters.
            
            Controls treatment of non-collinear magnetism within atomic MT spheres.
            These global parameters affect all atoms unless overridden at atom level.
            
            Key Parameters:
            
            l_mtNocoPot (default=F):
            Use full non-collinear potential inside MT spheres.
            - T: Full NC potential (more accurate, slower)
            - F: Scalar-relativistic approximation with effective B-field
            Recommendation: Set to T for accurate treatment of large canting angles.
            
            l_mperp (default=F):
            Include perpendicular magnetization components in MT spheres.
            Essential for capturing transverse magnetic fluctuations and
            off-diagonal density matrix elements.
            
            l_relaxSQA (default=F):
            Allow spin-quantization axis (SQA) to relax during SCF iterations.
            - T: Local moment direction optimized to minimize energy
            - F: SQA fixed at initial direction (defined by alpha, beta angles)
            Useful for finding ground-state magnetic configuration in complex systems.
            
            mag_mixing_scheme (default=0):
            Mixing scheme for magnetization density:
            - 0: Standard linear mixing
            - 1-3: Advanced schemes for difficult convergence cases
            
            mix_RelaxWeightOffD (default=1.0):
            Mixing weight for off-diagonal density matrix elements.
            Reduce (0.1-0.5) if convergence issues with NC components.
            
            l_constrained (default=F):
            Enable constrained local moment calculations.
            Enforces specific moment directions or magnitudes.
            
            mix_constr (default=1.0):
            Mixing parameter for constraint forces in constrained DFT.
            
            Workflow Tips:
            1. Start with l_mtNocoPot=F for initial convergence
            2. Switch to l_mtNocoPot=T for final accurate results
            3. Use l_relaxSQA=T to find optimal magnetic structure
            4. Reduce mixing weights if oscillations occur in NC components
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute default="F" name="l_mtNocoPot" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Use non-collinear potential inside muffin-tins.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_mperp" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Include perpendicular magnetization components.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_constrained" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable constrained local moment calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_relaxSQA" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Allow spin quantization axis to relax during SCF.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0" name="mag_mixing_scheme" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Mixing scheme for magnetization: 0=standard, 1-3=advanced schemes.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="1.0" name="mix_RelaxWeightOffD" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Mixing weight for off-diagonal density matrix elements.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="1.0" name="mix_constr" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Mixing parameter for constrained moments.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="SourceFreeMagType">
      <xsd:annotation>
         <xsd:documentation>Source-free magnetization settings for non-collinear calculations.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute default="F" name="l_sourceFree" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enforce source-free magnetization constraint.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_scaleMag" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Scale magnetization during SCF.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="1.0" name="mag_scale" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Scaling factor for magnetization.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>



   <xsd:complexType name="CoreElectronsType">
      <xsd:annotation>
         <xsd:documentation>Parameters for the treatment of core electrons.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="ctail" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>Use core tail corrections.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="frcor" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Activate frozen core approximation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0" name="kcrel" type="xsd:integer" use="optional">
         <xsd:annotation>
            <xsd:documentation>If true (1), fully relativistic core routines are used; otherwise only spin-polarized routines.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0" name="coretail_lmax" type="xsd:integer" use="optional">
         <xsd:annotation>
            <xsd:documentation>Cutoff for the expansion of the core-tail into other MT spheres. Also relevant for initial charge generation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="T" name="l_core_confpot" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="CellType">
      <xsd:annotation>
         <xsd:documentation>
            Cell section covering k-points for Brillouin zone integration, symmetry operations,
            and the lattice definition (bulk or film).
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="bzIntegration" type="BZIntegrationType">
            <xsd:annotation>
               <xsd:documentation>Brillouin zone integration settings including k-point lists.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="symmetryOperations" type="SymmetryOperationsType">
            <xsd:annotation>
               <xsd:documentation>Symmetry operations of the unit cell.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:choice>
            <xsd:element name="bulkLattice" type="BulkLatticeType">
               <xsd:annotation>
                  <xsd:documentation>Lattice definition for bulk (3D periodic) calculations.</xsd:documentation>
               </xsd:annotation>
            </xsd:element>
            <xsd:element name="filmLattice" type="FilmLatticeType">
               <xsd:annotation>
                  <xsd:documentation>Lattice definition for film (2D periodic) calculations.</xsd:documentation>
               </xsd:annotation>
            </xsd:element>
         </xsd:choice>
      </xsd:sequence>
   </xsd:complexType>


   <xsd:complexType name="SymmetryOperationsType">
      <xsd:annotation>
         <xsd:documentation>Container for space group symmetry operations. Up to 48 symmetry operations can be defined.</xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="48" minOccurs="1" name="symOp" type="SymOpMatrixType">
            <xsd:annotation>
               <xsd:documentation>Individual symmetry operation (rotation + translation).</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="MagnetismType">
      <xsd:annotation>
         <xsd:documentation>
            Parameters for controlling magnetism in the calculation, including
            collinear and non-collinear magnetic configurations.
            
            Non-Collinear Magnetism Setup:
            Non-collinear (NC) calculations treat magnetization as a 3D vector field,
            allowing modeling of complex magnetic structures beyond simple up/down spin.
            
            Basic Configuration:
            - jspins=1: Non-magnetic calculation
            - jspins=2: Magnetic calculation (collinear or non-collinear)
            - l_noco=T: Enable full non-collinear formalism (2-component spinors)
            - l_ss=T: Enable spin-spiral calculations with q-vector qss
            
            Spin Spirals:
            Periodic magnetic structures described by q-vector: M(r) = M₀·exp(iq·r)
            - qss element: Define spin-spiral wave vector in reciprocal space
            - Useful for studying magnon dispersion, spin-wave excitations
            - Can combine with force theorem for exchange coupling Jij
            
            Muffin-Tin Non-Collinear Parameters (mtNocoParams):
            Control how NC magnetism is treated in atomic spheres:
            - l_mtNocoPot=T: Use full NC potential in MT spheres (more accurate)
            - l_mperp=T: Include perpendicular magnetization components
            - l_relaxSQA=T: Allow local spin-quantization axes to relax during SCF
            - mag_mixing_scheme: Advanced mixing for NC density matrix (0=standard)
            
            Local Spin-Quantization Axis:
            Each atom can have individual spin axis defined by angles alpha (φ) and beta (θ)
            in spherical coordinates. Set via nocoParams in atomGroup.
            
            Common Workflows:
            1. Fixed spin spiral: Set l_ss=T, define qss, run with l_noco=F initially
            2. Relaxed NC: Set l_noco=T, l_relaxSQA=T, optimize local moments
            3. Constrained calculations: Use l_constrained=T with fixed moment directions
            
            Important Notes:
            - NC calculations require ~2× computational resources vs collinear
            - For small canting angles, perturbative approach (l_noco=F) often sufficient
            - Spin-orbit coupling automatically enabled with l_noco=T
            - Use fixed_moment attribute to constrain total magnetization
         </xsd:documentation>
      </xsd:annotation>
      <xsd:all>
         <xsd:element maxOccurs="1" minOccurs="0" name="qss" type="FleurDouble3DVecType">
            <xsd:annotation>
               <xsd:documentation>Spin spiral q-vector.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="qsc" type="FleurDouble3DVecType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="mtNocoParams" type="MTNocoParamsType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="sourceFreeMag" type="SourceFreeMagType"/>
      </xsd:all>
      <xsd:attribute name="jspins" type="SpinNumberType" use="required">
         <xsd:annotation>
            <xsd:documentation>Number of spins: 1 for non-magnetic, 2 for magnetic calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_noco" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable non-collinear magnetism treatment.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_ss" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable spin spiral calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_J" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="swsp" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Generate spin-polarized density from unpolarized density.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="lflip" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Flip spin directions for atoms with flipSpin flag set.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_onlyMtStDen" type="FleurBool" use="optional"/>
      <xsd:attribute name="fixed_moment" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Constrain the total magnetic moment to this value.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:simpleType name="SpinNumberType">
      <xsd:restriction base="xsd:integer">
         <xsd:minInclusive value="1"/>
         <xsd:maxInclusive value="2"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="BulkLatticeType">
      <xsd:annotation>
         <xsd:documentation>
            Lattice definition for bulk (3D periodic) calculations. The Bravais matrix
            defines the three lattice vectors.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="bravaisMatrix" type="Matrix3Type">
            <xsd:annotation>
               <xsd:documentation>3x3 matrix defining the lattice vectors in atomic units (Bohr).</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="scale" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Scale factor applied to all lattice vectors.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="FilmLatticeType">
      <xsd:annotation>
         <xsd:documentation>
            Lattice definition for film (2D periodic) calculations. Includes vacuum
            parameters dVac and dTilda for the film geometry.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:choice>
            <xsd:element name="bravaisMatrix" type="Matrix3Type"/>
            <xsd:element name="bravaisMatrixFilm" type="Matrix2Type"/>
         </xsd:choice>
         <xsd:element minOccurs="0" maxOccurs="2" name="vacuumEnergyParameters" type="VacuumEnergyParameterType"/>
      </xsd:sequence>
      <xsd:attribute name="scale" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Scale factor applied to lattice vectors.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="dVac" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Vacuum distance in atomic units (Bohr).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="dTilda" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Effective vacuum region size for the calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>


   <xsd:complexType name="VacuumEnergyParameterType">
      <xsd:attribute name="vacuum" type="xsd:integer" use="required"/>
      <xsd:attribute name="spinUp" type="FleurDouble" use="required"/>
      <xsd:attribute name="spinDown" type="FleurDouble" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="Matrix3Type">
      <xsd:sequence>
         <xsd:element name="row-1" type="FleurDouble3DVecType"/>
         <xsd:element name="row-2" type="FleurDouble3DVecType"/>
         <xsd:element name="row-3" type="FleurDouble3DVecType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="Matrix2Type">
      <xsd:sequence>
         <xsd:element name="row-1" type="FleurDouble2DVecType"/>
         <xsd:element name="row-2" type="FleurDouble2DVecType"/>
         </xsd:sequence>
   </xsd:complexType>

   <xsd:simpleType name="StringVecType">
      <xsd:list itemType="xsd:string"/>
   </xsd:simpleType>

   <xsd:simpleType name="String2DVecType">
      <xsd:restriction base="StringVecType">
         <xsd:length value="2"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="String3DVecType">
      <xsd:restriction base="StringVecType">
         <xsd:length value="3"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="FleurDoubleVecType">
      <xsd:list itemType="FleurDouble"/>
   </xsd:simpleType>

   <xsd:simpleType name="FleurDouble2DVecType">
      <xsd:restriction base="FleurDoubleVecType">
         <xsd:length value="2"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="FleurDouble3DVecType">
      <xsd:restriction base="FleurDoubleVecType">
         <xsd:length value="3"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="FleurDouble6DVecType">
      <xsd:restriction base="FleurDoubleVecType">
         <xsd:length value="6"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="TripleFleurBool">
      <xsd:restriction base="xsd:string">
         <xsd:pattern value="[FfTt][FfTt][FfTt]"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="DoubleVecType">
      <xsd:list itemType="xsd:double"/>
   </xsd:simpleType>

   <xsd:simpleType name="Double3DVecType">
      <xsd:restriction base="DoubleVecType">
         <xsd:length value="3"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="Double4DVecType">
      <xsd:restriction base="DoubleVecType">
         <xsd:length value="4"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="IntegerVecType">
      <xsd:list itemType="xsd:integer"/>
   </xsd:simpleType>

   <xsd:simpleType name="Integer3DVecType">
      <xsd:restriction base="IntegerVecType">
         <xsd:length value="3"/>
      </xsd:restriction>
   </xsd:simpleType>


  <xsd:simpleType name="Integer4DVecType">
      <xsd:restriction base="IntegerVecType">
         <xsd:length value="4"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="FleurBoolVecType">
      <xsd:list itemType="FleurBool"/>
   </xsd:simpleType>

   <xsd:simpleType name="FleurBool4DVecType">
      <xsd:restriction base="FleurBoolVecType">
         <xsd:length value="4"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="GFElementChoiceType">
      <xsd:sequence>
         <xsd:element name="s" type="FleurBool4DVecType"/>
         <xsd:element name="p" type="FleurBool4DVecType"/>
         <xsd:element name="d" type="FleurBool4DVecType"/>
         <xsd:element name="f" type="FleurBool4DVecType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="GFElementChoiceDiagType">
      <xsd:attribute name="s" type="FleurBool"/>
      <xsd:attribute name="p" type="FleurBool"/>
      <xsd:attribute name="d" type="FleurBool"/>
      <xsd:attribute name="f" type="FleurBool"/>
   </xsd:complexType>

   <xsd:complexType name="SymOpMatrixType">
      <xsd:sequence>
         <xsd:element name="row-1" type="Double4DVecType"/>
         <xsd:element name="row-2" type="Double4DVecType"/>
         <xsd:element name="row-3" type="Double4DVecType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="XCFunctionalType">
      <xsd:annotation>
         <xsd:documentation>Exchange-correlation functional settings. Defines the DFT functional used for calculations.</xsd:documentation>
      </xsd:annotation>
     <xsd:sequence>
         <xsd:element maxOccurs="1" minOccurs="0" name="LibXCID" type="XCLibXCIDType">
            <xsd:annotation>
               <xsd:documentation>LibXC functional IDs for exchange and correlation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="LibXCName" type="XCLibXCNameType">
            <xsd:annotation>
               <xsd:documentation>LibXC functional names for exchange and correlation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="xcParams" type="XCParamsType">
            <xsd:annotation>
               <xsd:documentation>Expert XC parameters for gradient evaluation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="ggaPrinting" type="GGAPrintingType">
            <xsd:annotation>
               <xsd:documentation>Settings for printing GGA-related quantities.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="name" type="XCFunctionalEnum" use="required">
         <xsd:annotation>
            <xsd:documentation>Functional name. LDA: x-a, mjw, pz, bh, wign, hl, vwn. GGA: l91, pw91, pbe, rpbe, Rpbe, wc, PBEs. Hybrid: pbe0, hse, vhse, lhse, hf. Or LibXC for custom functionals.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="relativisticCorrections" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable relativistic corrections to the XC functional.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="ProdBasisIRType">
      <xsd:annotation>
         <xsd:documentation>Product basis for GW/hybrid calculations in intermediate representation.</xsd:documentation>
      </xsd:annotation>
     <xsd:attribute name="gcutm" type="xsd:double" use="required">
        <xsd:annotation>
           <xsd:documentation>G-vector cutoff for mixed product basis (in atomic units).</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="bands" type="xsd:integer" use="required">
        <xsd:annotation>
           <xsd:documentation>Number of bands to include in the calculation.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="tolerance" type="xsd:double" use="optional" default="0.00001">
        <xsd:annotation>
           <xsd:documentation>Tolerance for linear dependence in product basis.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="lexp" type="xsd:integer" use="optional" default="16">
        <xsd:annotation>
           <xsd:documentation>Maximum angular momentum for product basis expansion.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="ewaldlambda" type="xsd:integer" use="optional" default="3">
        <xsd:annotation>
           <xsd:documentation>Ewald lambda parameter for long-range treatment.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="fftcut" type="xsd:double" use="optional" default="1.0">
        <xsd:annotation>
           <xsd:documentation>FFT cutoff factor.</xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
   </xsd:complexType>

   <xsd:simpleType name="XCFunctionalEnum">
      <xsd:annotation>
         <xsd:documentation>Available XC functionals. LDA: x-a (X-alpha), mjw (Moruzzi-Janak-Williams), pz (Perdew-Zunger), bh (Barth-Hedin), wign (Wigner), hl (Hedin-Lundqvist), vwn (Vosko-Wilk-Nusair). GGA: l91 (Langreth-Mehl), pw91, pbe, rpbe, Rpbe, wc (Wu-Cohen), PBEs (PBEsol). Hybrid: pbe0, hse (HSE06), vhse (variable HSE), lhse, hf (Hartree-Fock). LibXC: use external library.</xsd:documentation>
      </xsd:annotation>
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="x-a"/>
         <xsd:enumeration value="mjw"/>
         <xsd:enumeration value="pz"/>
         <xsd:enumeration value="bh"/>
         <xsd:enumeration value="wign"/>
         <xsd:enumeration value="hl"/>
         <xsd:enumeration value="vwn"/>
         <xsd:enumeration value="xal"/>
         <xsd:enumeration value="l91"/>
         <xsd:enumeration value="pw91"/>
         <xsd:enumeration value="pbe"/>
         <xsd:enumeration value="rpbe"/>
         <xsd:enumeration value="Rpbe"/>
         <xsd:enumeration value="wc"/>
	 <xsd:enumeration value="PBEs"/>
	 <xsd:enumeration value="pbe0"/>
	 <xsd:enumeration value="hse"/>
	 <xsd:enumeration value="vhse"/>
	 <xsd:enumeration value="lhse"/>
	 <xsd:enumeration value="hf"/>
	 <xsd:enumeration value="LibXC"/>
      </xsd:restriction>
   </xsd:simpleType>
   <xsd:complexType name="XCLibXCIDType">
      <xsd:attribute name="exchange"         type="xsd:integer" use="required"/>
      <xsd:attribute name="correlation"      type="xsd:integer" use="required"/>
      <xsd:attribute name="etot_exchange"    type="xsd:integer" use="optional"/>
      <xsd:attribute name="etot_correlation" type="xsd:integer" use="optional"/>
   </xsd:complexType>
   <xsd:complexType name="XCLibXCNameType">
      <xsd:attribute name="exchange"         type="xsd:string" use="required"/>
      <xsd:attribute name="correlation"      type="xsd:string" use="required"/>
      <xsd:attribute name="etot_exchange"    type="xsd:string" use="optional"/>
      <xsd:attribute name="etot_correlation" type="xsd:string" use="optional"/>
   </xsd:complexType>
   <xsd:complexType name="XCParamsType">
      <xsd:attribute name="igrd" type="xsd:integer" use="required"/>
      <xsd:attribute name="lwb" type="FleurBool" use="required"/>
      <xsd:attribute name="ndvgrd" type="xsd:integer" use="required"/>
      <xsd:attribute name="idsprs" type="xsd:integer" use="required"/>
      <xsd:attribute name="chng" type="xsd:double" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="GGAPrintingType">
      <xsd:attribute name="iggachk" type="xsd:integer" use="required"/>
      <xsd:attribute name="idsprs0" type="xsd:integer" use="required"/>
      <xsd:attribute name="idsprsl" type="xsd:integer" use="required"/>
      <xsd:attribute name="idsprsi" type="xsd:integer" use="required"/>
      <xsd:attribute name="idsprsv" type="xsd:double" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="AtomSpeciesType">
      <xsd:annotation>
         <xsd:documentation>
            Container for atom species definitions. Species allow setting identical numerical
            parameters for atoms of different atom groups without redundancy.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="unbounded" name="species" type="SpeciesType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="ProdBasisMTType">
     <xsd:attribute name="lcutm" type="xsd:integer" use="required"/>
     <xsd:attribute name="lcutwf" type="xsd:integer" use="required"/>
     <xsd:attribute name="select" type="xsd:string" use="optional" default="4 0 4 2"/>
   </xsd:complexType>

   <xsd:simpleType name="ZeroToOneNumberType">
      <xsd:restriction base="xsd:double">
         <xsd:minInclusive value="0.0"/>
         <xsd:maxInclusive value="1.0"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="SpecialType">
     <xsd:attribute name="lda" type="FleurBool" use="optional" default="F"/>
     <xsd:attribute name="socscale" type="FleurDouble" use="optional" default="1.0"/>
     <xsd:attribute name="nonSpinPolBasis" type="FleurBool" use="optional" default="F"/> 
     <xsd:attribute name="b_field_mt" type="FleurDouble" use="optional" default="0.0">
        <xsd:annotation>
           <xsd:documentation>
              Magnetic field applied only to this atom species (in MT sphere).
              Adds Zeeman term to potential for this specific atom.
              Can be used in combination with global b_field or independently.
              Supported in both film and bulk setups.
           </xsd:documentation>
        </xsd:annotation>
     </xsd:attribute>
     <xsd:attribute name="vca_charge" type="FleurDouble" use="optional" default="0.0"/>
   </xsd:complexType>



   <xsd:complexType name="SpeciesType">
      <xsd:annotation>
         <xsd:documentation>
            Defines numerical parameters for a group of atoms of the same chemical element.
            The species name is used to associate atom groups with these parameters.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="mtSphere" type="MTSphereType">
            <xsd:annotation>
               <xsd:documentation>Muffin-tin sphere properties.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="atomicCutoffs" type="AtomicCutoffsType">
            <xsd:annotation>
               <xsd:documentation>Angular momentum cutoffs for this species.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element name="electronConfig" type="ElectronConfigType">
            <xsd:annotation>
               <xsd:documentation>Core and valence electron configuration.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="energyParameters" type="EnergyParametersType">
            <xsd:annotation>
               <xsd:documentation>Energy parameters (main quantum numbers) for valence states.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="prodBasis" type="ProdBasisMTType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="special" type="SpecialType">
            <xsd:annotation>
               <xsd:documentation>
                  Special parameters like SOC scaling, VCA charge, local LDA usage, and species-specific magnetic field.
                  
                  Use b_field_mt to apply magnetic field only to this atom species.
                  This is alternative to global b_field in calculationSetup/fields.
               </xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="force" type="ForceType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="nocoParams" type="AtomicNocoParamsType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="modInitDen" type="ModInitDenType"/>
         <xsd:element maxOccurs="4" minOccurs="0" name="ldaOPC" type="LdaOPCType"/>
         <xsd:element maxOccurs="4" minOccurs="0" name="ldaU" type="LdaUType">
            <xsd:annotation>
               <xsd:documentation>LDA+U parameters for this species. Defines U and J for specific l channels.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="4" minOccurs="0" name="ldaHIA" type="LdaHubbard1Type"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="greensfCalculation" type="GFcalcType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="torqueCalculation" type="TorqueGFType"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="lo" type="LOType">
            <xsd:annotation>
               <xsd:documentation>Local orbital definitions for this species.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="name" type="xsd:string" use="required">
         <xsd:annotation>
            <xsd:documentation>Unique name for this species, referenced by atom groups.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="element" type="xsd:string" use="optional">
         <xsd:annotation>
            <xsd:documentation>Chemical element abbreviation (e.g., Si, Fe, O).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="atomicNumber" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Atomic number (Z) of the element.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="AtomGroupsType">
      <xsd:annotation>
         <xsd:documentation>
            Container for atom groups. Each group contains symmetry equivalent atoms
            and is associated with a species for its numerical parameters.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element maxOccurs="unbounded" name="atomGroup" type="AtomGroupType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="AtomGroupType">
      <xsd:annotation>
         <xsd:documentation>
            Group of symmetry equivalent atoms. Contains atom positions (relative, absolute, or film)
            and optional overrides for species parameters.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:choice maxOccurs="unbounded">
            <xsd:element name="relPos" type="AtomPosType">
               <xsd:annotation>
                  <xsd:documentation>Atom position in relative (fractional) coordinates of the lattice vectors.</xsd:documentation>
               </xsd:annotation>
            </xsd:element>
            <xsd:element name="absPos" type="AtomPosType">
               <xsd:annotation>
                  <xsd:documentation>Atom position in absolute coordinates (Bohr).</xsd:documentation>
               </xsd:annotation>
            </xsd:element>
            <xsd:element name="filmPos" type="AtomPosType">
               <xsd:annotation>
                  <xsd:documentation>Atom position for films: first two coordinates relative, third absolute in Bohr.</xsd:documentation>
               </xsd:annotation>
            </xsd:element>
         </xsd:choice>
         <xsd:element maxOccurs="1" minOccurs="0" name="mtSphere" type="MTSphereType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="atomicCutoffs" type="AtomicCutoffsType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="energyParameters" type="EnergyParametersType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="force" type="ForceType">
            <xsd:annotation>
               <xsd:documentation>Force calculation and relaxation settings for this atom group.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="nocoParams" type="AtomicNocoParamsType">
            <xsd:annotation>
               <xsd:documentation>Non-collinear magnetism parameters for this atom group.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <xsd:element maxOccurs="1" minOccurs="0" name="modInitDen" type="ModInitDenType"/>
         <xsd:element maxOccurs="4" minOccurs="0" name="ldaU" type="LdaUType"/>
         <xsd:element maxOccurs="4" minOccurs="0" name="ldaHIA" type="LdaHubbard1Type"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="greensfCalculation" type="GFcalcType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="torqueCalculation" type="TorqueGFType"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="lo" type="LOType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="orbcomprot" type="Double3DVecType"/>
         <xsd:element maxOccurs="1" minOccurs="0" name="cFCoeffs" type="cFCoeffsOutputType"/>
      </xsd:sequence>
      <xsd:attribute name="species" type="xsd:string" use="required">
         <xsd:annotation>
            <xsd:documentation>Name of the species this atom group belongs to.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="magField" type="xsd:double" use="optional"/>
      <xsd:attribute name="vcaAddCharge" type="xsd:double" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="AtomPosType">
      <xsd:simpleContent>
         <xsd:extension base="FleurDouble3DVecType">
            <xsd:attribute default=" " name="label" type="xsd:string" use="optional"/>
            <xsd:attribute default="F" name="wannier" type="FleurBool" use="optional"/>
            <xsd:attribute name="banddos" type="FleurBool" use="optional"/>
            <xsd:attribute name="alpha" type="FleurDouble" use="optional"/>
            <xsd:attribute name="beta"  type="FleurDouble" use="optional"/>
            <xsd:attribute name="gamma" type="FleurDouble" use="optional"/>
         </xsd:extension>
      </xsd:simpleContent>
   </xsd:complexType>

   <xsd:complexType name="AtomicNocoParamsType">
      <xsd:annotation>
         <xsd:documentation>Non-collinear magnetic parameters for an atom group.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="l_constrained" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable constrained local moment for this atom.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_fixedMoment" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Fix the magnetic moment magnitude.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_mtNocoPot" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Use non-collinear potential in this atom's MT sphere.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_relaxSQA" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Allow spin quantization axis to relax for this atom.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_magn" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Enable magnetic treatment for this atom.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="M" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Constrained magnetic moment magnitude (Bohr magnetons).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="alpha" type="FleurDouble" use="optional" default="0.0">
         <xsd:annotation>
            <xsd:documentation>
               Azimuthal angle α (phi) defining local spin-quantization axis in spherical coordinates.
               Specifies rotation around z-axis: α ∈ [0, 2π)
               
               The local magnetization direction is defined by spherical angles (α, β):
               - α (alpha): Azimuthal angle (φ) - rotation in xy-plane
               - β (beta): Polar angle (θ) - tilt from z-axis
               
               Cartesian conversion:
               m_x = sin(β)·cos(α)
               m_y = sin(β)·sin(α)  
               m_z = cos(β)
               
               Common configurations:
               - α=0°, β=0°: Moment along +z
               - α=0°, β=90°: Moment along +x
               - α=90°, β=90°: Moment along +y
               - α=0°, β=180°: Moment along -z
               
               For spin spirals: α often varied systematically while β remains fixed.
               With l_relaxSQA=T, these provide initial guess only; final angles optimized by SCF.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="beta" type="FleurDouble" use="optional" default="0.0">
         <xsd:annotation>
            <xsd:documentation>
               Polar angle β (theta) defining local spin-quantization axis in spherical coordinates.
               Specifies tilt from z-axis: β ∈ [0, π]
               Default: 0.0 (moment along +z axis)
               
               Physical interpretation:
               - β = 0: Moment parallel to +z ("spin-up" in collinear language)
               - β = π/2: Moment in xy-plane (perpendicular to z)
               - β = π: Moment parallel to -z ("spin-down" in collinear language)
               
               Combined with α, defines full 3D orientation of local magnetic moment.
               See alpha documentation for coordinate transformation and examples.
               
               Note: For non-collinear spin spirals, β often kept constant (typically π/2)
               while α varies spatially according to q-vector in magnetism/@qss.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="b_cons_x" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Constraint field x-component.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="b_cons_y" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Constraint field y-component.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="ModInitDenType">
      <xsd:annotation>
         <xsd:documentation>Modifications to initial density/magnetization for an atom.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute default="0.0" name="magMom" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Initial magnetic moment (Bohr magnetons).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="flipSpinPhi" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Azimuthal angle for spin rotation (radians).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="flipSpinTheta" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Polar angle for spin rotation (radians).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="flipSpinScale" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Scale spin during flip operation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="MTSphereType">
      <xsd:annotation>
         <xsd:documentation>Muffin-tin sphere properties for an atom species.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="radius" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Radius of the muffin-tin sphere in atomic units (Bohr).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="gridPoints" type="xsd:positiveInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Number of radial grid points within the MT sphere.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="logIncrement" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Logarithmic increment of the radial mesh.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="AtomicCutoffsType">
      <xsd:annotation>
         <xsd:documentation>Angular momentum cutoff parameters for an atom species.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="lmax" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Maximum angular momentum (l) for the LAPW expansion.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="lnonsphr" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Reduced l-cutoff for non-spherical potential contributions.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="lmaxAPW" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>If present, enables APW+lo approach. Cutoff defining lmax up to which LAPWs are used if no APW+lo LO is defined.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="EnergyParametersType">
      <xsd:annotation>
         <xsd:documentation>Main quantum numbers for the energy parameters of valence states.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="s" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Main quantum number for valence s electrons.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="p" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Main quantum number for valence p electrons.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="d" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Main quantum number for valence d electrons.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="f" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Main quantum number for valence f electrons.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="LdaUType">
      <xsd:annotation>
         <xsd:documentation>
            LDA+U parameters for a specific l channel on this species.
            
            Implementation follows Shick et al., PRB 60, 10763 (1999).
            The U parameter acts on parts of LAPW basis functions with the specified
            angular momentum quantum number, not on Kohn-Sham orbitals directly.
            
            Important notes:
            - Up to 4 different U parameters can be specified per atom species
            - U affects only MT spheres; adequate U may depend on MT radius
            - U parameters may not be directly comparable between different DFT codes
            - For localized states, differences between codes have limited impact
            - For delocalized states, MT-only application may cause significant deviations
            - If LO and ldaU use same l, LO's extra radial function is unaffected by U
              (acceptable if LO represents semicore and U targets valence/conduction)
            
            Density matrix:
            - (2l+1)×(2l+1) matrix determined self-consistently
            - Written to n_mmp_mat_out each iteration
            - Can provide initial guess via n_mmp_mat file
            - Also written to out.xml in densityMatrixFor sections
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="l" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Angular momentum channel (0=s, 1=p, 2=d, 3=f) for the U correction.
               U acts on LAPW basis function parts with this quantum number in MT sphere.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="U" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Hubbard U parameter in eV.
               Corrects self-interaction error for correlated electrons.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="J" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Hund's exchange J parameter in eV.
               Accounts for intra-atomic exchange interactions.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="phi" type="FleurDouble" use="optional" default="0.0"/>
      <xsd:attribute name="theta" type="FleurDouble" use="optional" default="0.0"/>
      <xsd:attribute name="l_amf" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>
               If true (T), use around-mean-field (AMF) limit.
               If false (F), use atomic limit (also called FLL - fully localized limit).
               Choice affects double-counting correction in LDA+U formalism.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="LdaVType">
      <xsd:sequence>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="ldaVRegion" type="LdaVRegionType"/>
      </xsd:sequence>
   </xsd:complexType>

   <xsd:complexType name="LdaVRegionType">
      <xsd:sequence>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="ldaVPair" type="LdaVPairType"/>
      </xsd:sequence>
      <xsd:attribute name="V" type="FleurDouble" use="required"/>
      <xsd:attribute name="refAtom" type="xsd:positiveInteger" use="required"/>
      <xsd:attribute name="refAtomL" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="otherAtomL" type="xsd:nonNegativeInteger" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="LdaVPairType">
      <xsd:attribute name="otherAtom" type="xsd:positiveInteger" use="required"/>
      <xsd:attribute name="shiftX" type="xsd:integer" use="required"/>
      <xsd:attribute name="shiftY" type="xsd:integer" use="required"/>
      <xsd:attribute name="shiftZ" type="xsd:integer" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="LdaOPCType">
      <xsd:attribute name="l" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="n" type="xsd:nonNegativeInteger" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="LdaHubbard1Type">
      <xsd:sequence>
         <xsd:element maxOccurs="3" minOccurs="0" name="exc" type="ExcType"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="cFCoeff" type="cFCoeffInputType"/>
         <xsd:element maxOccurs="unbounded" minOccurs="0" name="addArg"  type="SolverArgType"/>
      </xsd:sequence>
      <xsd:attribute name="l" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="U" type="FleurDouble" use="required"/>
      <xsd:attribute name="J" type="FleurDouble" use="required"/>
      <xsd:attribute name="phi" type="FleurDouble" use="optional" default="0.0"/>
      <xsd:attribute name="theta" type="FleurDouble" use="optional" default="0.0"/>
      <xsd:attribute name="l_amf" type="FleurBool" use="required"/>
      <xsd:attribute default="calc" name="init_occ"      type="ManualCutoffType" use="optional"/>
      <xsd:attribute default="calc" name="kkintgrCutoff" type="ManualKKintgrCutoffType" use="optional"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="ExcType">
      <xsd:attribute name="l" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="J" type="FleurDouble" use="required"/>
      <xsd:attribute default="calc" name="init_mom" type="ManualCutoffType" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="cFCoeffInputType">
      <xsd:attribute name="l" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="m" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute name="value" type="FleurDouble" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="SolverArgType">
      <xsd:attribute name="key" type="xsd:string" use="required"/>
      <xsd:attribute name="value" type="xsd:string" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="GFcalcType">
      <xsd:annotation>
         <xsd:documentation>
            Green's function calculation element selection and orbital specifications.
            
            Determines which GF matrix elements to calculate between atomic sites.
            Choice between full matrix or diagonal elements only affects computational cost.
            
            Element Selection:
            
            matrixElements:
            Calculate off-diagonal GF matrix elements G_ij between sites i≠j.
            - Required for: Exchange couplings Jij, non-local properties, RKKY interactions
            - More expensive: scales as O(N²) with number of sites
            - Essential for: Magnetic exchange, Kondo physics, quantum transport
            
            diagElements:
            Calculate only diagonal elements G_ii (on-site Green's functions).
            - Faster: scales as O(N) with number of sites
            - Sufficient for: Local DOS, orbital occupations, on-site spectroscopy
            - Use for: Quick analysis, local magnetic properties, core-level spectra
            
            Attributes:
            
            l_sphavg (default=T):
            Perform spherical averaging of Green's function in MT spheres.
            - T: Average over angular momentum → simpler orbital structure
            - F: Keep full angular resolution → detailed orbital character
            
            nshells (default=0):
            Number of neighbor shells to include in GF calculation.
            - 0: Automatic (include all shells up to unit cell boundary)
            - N: Include N nearest-neighbor shells explicitly
            - Use for: Controlling interaction range in Jij calculations
            
            kkintgrCutoff (default="calc"):
            Cutoff for KKR integration (Korringa-Kohn-Rostoker method).
            Options:
            - "calc": Automatic based on energy convergence
            - number: Fixed cutoff in energy units
            - "s","p","d","f": Use l-channel specific cutoffs
            
            Recommendation: Start with "calc", use explicit values only for testing.
            
            k_resolved (default=F):
            Calculate k-point resolved Green's functions.
            - T: G(k,E) for band structure analysis
            - F: Brillouin zone averaged G(E)
            
            shellElement (default="all"):
            Select specific elements for shell-resolved output.
            Use element symbols (e.g., "Fe", "Co") or "all".
            
            magneticShells (default=T):
            Include magnetic character in shell selection.
            Distinguishes spin-up/down contributions in magnetic systems.
            
            startFromShell (default=0):
            Skip first N shells in calculation (for focusing on distant interactions).
            
            Typical Workflows:
            
            1. Local DOS:
               - Use diagElements, l_sphavg=T
               - Single site or few sites, minimal computational cost
            
            2. Exchange couplings Jij:
               - Use matrixElements, nshells≥3
               - Calculate G_ij between magnetic atoms
               - Post-process with force theorem module
            
            3. Spectroscopy:
               - Use diagElements, l_sphavg=F for orbital resolution
               - Focus on specific atom type with shellElement
               - Use k_resolved=T if angle-resolved data needed
         </xsd:documentation>
      </xsd:annotation>
      <xsd:choice>
         <xsd:element name="matrixElements" type="GFElementChoiceType"/>
         <xsd:element name="diagElements" type="GFElementChoiceDiagType"/>
      </xsd:choice>
      <xsd:attribute default="T"       name="l_sphavg" type="FleurBool"/>
      <xsd:attribute default="0"       name="nshells" type="xsd:nonNegativeInteger" use="optional"/>
      <xsd:attribute default="calc"    name="kkintgrCutoff" type="ManualKKintgrCutoffType" use="optional"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
      <xsd:attribute default="F"       name="k_resolved" type="FleurBool" use="optional"/>
      <xsd:attribute default="all"     name="shellElement" type="xsd:string" use="optional"/>
      <xsd:attribute default="T"       name="magneticShells" type="FleurBool" use="optional"/>
      <xsd:attribute default="0"       name="startFromShell" type="xsd:nonNegativeInteger" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="TorqueGFType">
      <xsd:sequence>
         <xsd:element name="greensfElements" type="GFElementChoiceType"/>
      </xsd:sequence>
      <xsd:attribute default="calc"    name="kkintgrCutoff" type="ManualKKintgrCutoffType" use="optional"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
   </xsd:complexType>

   <xsd:simpleType name="ManualCutoffType">
      <xsd:union>
        <xsd:simpleType>
          <xsd:restriction base="xsd:double"/>
        </xsd:simpleType>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:enumeration value="calc"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:union>
    </xsd:simpleType>

    <xsd:simpleType name="ManualKKintgrCutoffType">
      <xsd:union>
        <xsd:simpleType>
          <xsd:restriction base="xsd:double"/>
        </xsd:simpleType>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:enumeration value="calc"/>
            <xsd:enumeration value="s"/>
            <xsd:enumeration value="p"/>
            <xsd:enumeration value="d"/>
            <xsd:enumeration value="f"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:union>
    </xsd:simpleType>

   <xsd:complexType name="ForceType">
      <xsd:annotation>
         <xsd:documentation>
            Force calculation settings for an atom group.
            
            Forces are calculated as negative variation of total energy with respect
            to atom positions. Requirements for force calculations are stricter than
            for simple total energy differences:
            - May require treating semicore states as valence (via LOs)
            - Higher cutoff parameters may be needed for LAPW basis convergence
            - Important for structural optimization workflows
            
            Usage in structural relaxations:
            1. Reduce MT radii to ~95% to prevent overlapping spheres during relaxation
            2. Enable calculate=T for atom groups to be optimized
            3. Set relaxXYZ to specify allowed displacement directions
            4. Configure geometryOptimization in calculationSetup
            5. Run Fleur iteratively; displacements stored in relax.xml
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="calculate" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Enable force calculation for atoms in this group.
               Forces only calculated if geometryOptimization/@l_f is also true.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="TTT" name="relaxXYZ" type="TripleFleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Three boolean flags specifying which Cartesian directions (x,y,z) may be relaxed.
               Example: "FFT" allows only z-direction relaxation (common for film systems).
               Only effective when calculate=T and geometryOptimization is active.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="LOType">
      <xsd:annotation>
         <xsd:documentation>Local orbital definition for treating semicore or high-energy states.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="type" type="EParamSelectionEnum" use="required">
         <xsd:annotation>
            <xsd:documentation>Type of local orbital: SCLO for semicore, HELO for high-energy.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l" type="AngularMomentumNumberType" use="required">
         <xsd:annotation>
            <xsd:documentation>Angular momentum quantum number for this LO.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="n" type="MainQuantumNumberType" use="required">
         <xsd:annotation>
            <xsd:documentation>Main quantum number for this LO.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0" name="eDeriv" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Energy derivative order. 0 for conventional LOs, positive integer for HDLOs.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

    <xsd:simpleType name="AngularMomentumNumberType">
      <xsd:restriction base="xsd:string">
         <xsd:pattern value="([1-9])?[0-9](((-([1-9])?[0-9])?)|(,([1-9])?[0-9])+)"/>
      </xsd:restriction>
   </xsd:simpleType>

    <xsd:simpleType name="MainQuantumNumberType">
      <xsd:restriction base="xsd:string">
         <xsd:pattern value="[1-9]([0-9])?(,[1-9]([0-9])?)*"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:simpleType name="EParamSelectionEnum">
      <xsd:restriction base="xsd:string">
         <xsd:enumeration value="SCLO"/>
         <xsd:enumeration value="HELO"/>
      </xsd:restriction>
   </xsd:simpleType>

   <xsd:complexType name="CutoffsType">
      <xsd:annotation>
         <xsd:documentation>Main cutoff parameters for the LAPW calculation.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="Kmax" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Plane wave cutoff for the basis functions (in a.u.^-1). Determines RKmax via R*Kmax.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="Gmax" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Cutoff for the charge density Fourier expansion (in a.u.^-1). Should be at least 3*Kmax.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="GmaxXC" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Cutoff for the potential when calculating the XC functional. If 0, Gmax is used.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="Gmaxz" type="FleurDouble" use="optional"/>
      <xsd:attribute default="0" name="numbands" type="NumBandsType" use="optional">
         <xsd:annotation>
            <xsd:documentation>Number of eigenvalues to calculate at each k-point. 0 means use default value.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

    <xsd:simpleType name="NumBandsType">
      <xsd:union>
        <xsd:simpleType>
          <xsd:restriction base="xsd:nonNegativeInteger"/>
        </xsd:simpleType>
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:enumeration value="all"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:union>
    </xsd:simpleType>

   <xsd:complexType name="BZIntegrationType">
      <xsd:annotation>
         <xsd:documentation>Brillouin zone integration settings including k-point sampling and smearing methods.</xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="kPointListSelection" type="KPointListSelectionType">
            <xsd:annotation>
               <xsd:documentation>Selects which k-point list to use for the calculation.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
         <!--<xsd:element maxOccurs="unbounded" minOccurs="0" name="altKPointList" type="AltKPointListSelectionType"/>-->
         <xsd:element name="kPointLists" type="KPointListsType">
            <xsd:annotation>
               <xsd:documentation>Container for multiple k-point list definitions.</xsd:documentation>
            </xsd:annotation>
         </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="valenceElectrons" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Number of valence electrons. Usually determined automatically.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="hist" name="mode" type="BZIntegrationModeEnum" use="optional">
         <xsd:annotation>
            <xsd:documentation>Integration mode: hist (histogram), gauss (Gaussian smearing), tria (tetrahedron), etc.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="fermiSmearingEnergy" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Fermi smearing energy in Hartree. Alternative to fermiSmearingTemp.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="fermiSmearingTemp" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Fermi smearing temperature in Kelvin. Used for Fermi-Dirac or Gaussian smearing.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_bloechl" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Use Blöchl tetrahedron corrections for improved BZ integration accuracy.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="charge_excited" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Number of electrons in excited states (for constrained occupation calculations).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="charge_shift" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Shift in number of electrons for charged system calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="SOCType">
      <xsd:annotation>
         <xsd:documentation>Spin-orbit coupling parameters.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="theta" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Polar angle (in radians) of the spin quantization axis.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="phi" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Azimuthal angle (in radians) of the spin quantization axis.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="l_soc" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>Enable spin-orbit coupling in the calculation.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="spav" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>Construct spin-orbit operator from spin-averaged potential.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="off" type="FleurBool" use="optional"/>
      <xsd:attribute default="T" name="soc66" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="SCFLoopType">
      <xsd:annotation>
         <xsd:documentation>Parameters controlling SCF loop iterations and density mixing.</xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="itmax" type="xsd:nonNegativeInteger" use="required">
         <xsd:annotation>
            <xsd:documentation>Maximum number of SCF iterations to perform.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="99" name="maxIterBroyd" type="xsd:nonNegativeInteger" use="optional">
         <xsd:annotation>
            <xsd:documentation>Number of iterations for Broyden-like mixing history. History is periodically deleted with this periodicity.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="imix" type="MixingEnum" use="required">
         <xsd:annotation>
            <xsd:documentation>Mixing scheme: straight, Broyden1, Broyden2, Anderson, Pulay, etc.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="alpha" type="FleurDouble" use="required">
         <xsd:annotation>
            <xsd:documentation>Mixing parameter (0 to 1). Smaller values give more stable but slower convergence.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="precondParam" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Preconditioning parameter for bulk metals. Typical value: 0.8. Use with higher alpha (~0.25).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="2.0" name="spinf" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Spin mixing factor enhancement for magnetic calculations.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.0" name="minDistance" type="FleurDouble" use="optional">
         <xsd:annotation>
            <xsd:documentation>Convergence criterion: stop if density distance falls below this value.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="maxTimeToStartIter" type="FleurDouble" use="optional"/>
   </xsd:complexType>


         <xsd:annotation>
            <xsd:documentation>Output all states in energy window.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="GeometryOptimizerType">
      <xsd:annotation>
         <xsd:documentation>
            Parameters for force calculations and structural optimization.
            
            Workflow for atom position optimization:
            1. Prepare: Reduce MT radii to ~95% of default (e.g., radius="0.95*2.22")
            2. Select: Set force/@calculate=T and force/@relaxXYZ for each atom group
            3. Activate: Set l_f=T to enable force optimization
            4. Configure: Choose algorithm (BFGS recommended), set mixing and convergence
            5. Iterate: Run Fleur multiple times; displacements accumulate in relax.xml
            
            Important notes:
            - Delete charge density file when changing MT radii or geometry
            - Start near expected optimum to avoid divergence
            - Ensure initial positions don't preserve unphysical symmetries
            - Total energies with different MT radii are not directly comparable
            - Energy differences typically converge with smaller basis than total energies
            
            Optimization algorithms:
            - BFGS (default): Efficient quasi-Newton method, best for near-optimal geometries
            - straight: Linear mixing, more stable for far-from-optimal configurations
            - CG: Conjugate gradient method
            
            Output files:
            - relax.xml: Contains displacements and relaxation history
            - out.xml: Total energy per iteration (grep "&lt;totalEnergy" out.xml)
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="l_f" type="FleurBool" use="required">
         <xsd:annotation>
            <xsd:documentation>
               Master switch to enable force calculation and structural optimization.
               When true, forces calculated after SCF convergence and new displacements generated.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="f_level" type="xsd:integer" use="optional" default="-1"/>
      <xsd:attribute name="l_driftForce" type="FleurBool" use="optional" default="F"/>
      <xsd:attribute name="forcealpha" type="FleurDouble" use="optional" default="0">
         <xsd:annotation>
            <xsd:documentation>
               Mixing parameter α_force for force optimization.
               Typical value: 1.0 for BFGS. Controls step size in geometry updates.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="epsdisp" type="FleurDouble" use="optional" default="0.001">
         <xsd:annotation>
            <xsd:documentation>
               Convergence criterion for maximum change in atom positions between iterations.
               Relaxation converged when max(Δpos) &lt; epsdisp. Typical: 0.00001 a.u.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="epsforce" type="FleurDouble" use="optional" default="0.001">
         <xsd:annotation>
            <xsd:documentation>
               Convergence criterion for maximum force magnitude.
               Relaxation converged when max(|F|) &lt; epsforce. Typical: 0.00001 Hartree/bohr.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="forcemix" type="ForceMixEnum" use="optional" default="BFGS">
         <xsd:annotation>
            <xsd:documentation>
               Force optimization algorithm selection:
               - BFGS (default): Quasi-Newton, efficient near minimum, uses relaxation history
               - straight: Linear mixing, more stable but slower
               - CG: Conjugate gradient
               
               BFGS assumes parabolic energy landscape near optimum. For large displacements,
               use 'straight' initially then switch to BFGS when closer to minimum.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="qfix" type="xsd:integer" use="optional" default="0"/>
      <xsd:attribute name="force_converged" type="FleurDouble" use="optional" default="0.00001"/>
   </xsd:complexType>

   <xsd:complexType name="LdaUGeneralType">
      <xsd:annotation>
         <xsd:documentation>
            General LDA+U settings for density matrix mixing in calculationSetup.
            
            The density matrix for each U parameter must be determined self-consistently
            alongside the charge density. This element controls how the density matrix
            is mixed between iterations.
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute default="F" name="l_linMix" type="FleurBool" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Mixing strategy for density matrix:
               - If true (T): Linear mixing with parameter mixParam
               - If false (F): Mix consistently with charge density
               Linear mixing can help convergence for difficult systems.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="0.05" name="mixParam" type="xsd:double" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Mixing parameter for linear density matrix mixing (when l_linMix=T).
               Typical values: 0.01-0.1. Smaller values = more stable but slower.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="1.00" name="spinf" type="xsd:double" use="optional">
         <xsd:annotation>
            <xsd:documentation>
               Spin factor for LDA+U calculations.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute default="F" name="l_adjEnpara" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="l_spinoffd" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="l_nonsphDC" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="l_initialGuess" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="LdaHIAGeneralType">
      <xsd:attribute name="itmaxHubbard1" type="xsd:nonNegativeInteger" use="required"/>
      <xsd:attribute default="100.0" name="beta" type="xsd:double" use="optional"/>
      <xsd:attribute default="0.01" name="minoccDistance" type="xsd:double" use="optional"/>
      <xsd:attribute default="0.001" name="minmatDistance" type="xsd:double" use="optional"/>
      <xsd:attribute default="2" name="n_occpm" type="xsd:nonNegativeInteger" use="optional"/>
      <xsd:attribute default="F" name="dftspinpol" type="FleurBool" use="optional"/>
      <xsd:attribute default="T" name="fullMatch" type="FleurBool" use="optional"/>
      <xsd:attribute default="T" name="l_nonsphDC" type="FleurBool" use="optional"/>
      <xsd:attribute default="T" name="l_correctEtot" type="FleurBool" use="optional"/>
      <xsd:attribute default="F" name="l_forceHIAiteration" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="cFCoeffsOutputType">
      <xsd:attribute name="chargeDensity" type="FleurBool" use="required"/>
      <xsd:attribute name="potential" type="FleurBool" use="required"/>
      <xsd:attribute default="F" name="remove4f" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="GFGeneralType">
      <xsd:annotation>
         <xsd:documentation>
            Green's function calculation general settings and energy contour specification.
            
            Green's functions G(E) calculated via energy contour integration in complex plane:
            G = ∫_C dE f(E) G(E), where C is integration contour and f(E) is occupation.
            
            Energy Contour Setup:
            Required elements:
            1. realAxis: Real-energy axis for final output (ne points from ellow to elup)
            2. One or more contours: Define integration path in complex E-plane
            
            Available Contour Types:
            
            contourSemicircle:
            Semicircular contour in lower complex half-plane.
            - Optimal for occupied states below Fermi level
            - Parameters: n (points), eb (bottom energy), et (top energy), alpha (scaling)
            - Contour: E = eb + R·exp(iθ), θ ∈ [π, 2π], R = (et-eb)·alpha/2
            
            contourDOS (equidistant):
            Rectangular path for DOS-like integration.
            - Good for states near Fermi level
            - Parameters: n (points), eb/et (energy range), sigma (broadening)
            - l_fermi=T: Include Fermi function in integration
            - analytical_cont=T: Use Kramers-Kronig for real-axis projection
            
            contourRectangle:
            Full rectangular contour in complex plane.
            - Most general, includes Matsubara frequencies
            - Parameters: n1,n2,n3 (points on three sides), nmatsub (Matsubara points)
            - eb: bottom energy, sigma: imaginary offset
            
            Multiple Contours:
            Can specify multiple contours to combine different energy regions:
            - Semicircle for deep occupied states (fast convergence)
            - DOS contour near Fermi level (accurate spectral features)
            - Rectangle for unoccupied states (include Matsubara tail)
            
            Global Attributes:
            
            l_mperp (default=F):
            Include perpendicular magnetization in GF (non-collinear calculations).
            
            outputSphavg (default=F):
            Output spherically averaged Green's functions.
            
            intFullRadial (default=F):
            Integrate over full radial extent (vs MT sphere only).
            
            minCalcDistance (default=-1.0):
            Minimum distance for calculating GF between sites.
            -1.0: automatic (use nearest-neighbor distance).
            
            Common Workflow:
            1. Start with single contourSemicircle for quick test
            2. Add contourDOS near EF for accurate Fermi surface properties
            3. Verify convergence by increasing n (number of energy points)
            4. For Kramers-Kronig: Use realAxis with sufficient energy range
         </xsd:documentation>
      </xsd:annotation>
      <xsd:sequence>
         <xsd:element name="realAxis" type="ERealAxisType"/>
         <xsd:sequence>
            <xsd:choice maxOccurs="unbounded" minOccurs="1">
               <xsd:element name="contourRectangle"   type="EContourRectangleType"/>
               <xsd:element name="contourSemicircle"  type="EContourSemicircleType"/>
               <xsd:element name="contourDOS"         type="EContourDOSType"/>
            </xsd:choice>
         </xsd:sequence>
      </xsd:sequence>
      <xsd:attribute default="F"    name="l_mperp" type="FleurBool" use="optional"/>
      <xsd:attribute default="-1.0" name="minCalcDistance" type="xsd:double" use="optional"/>
      <xsd:attribute default="F"    name="outputSphavg" type="FleurBool" use="optional"/>
      <xsd:attribute default="F"    name="intFullRadial" type="FleurBool" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="ERealAxisType">
      <xsd:attribute default="1300" name="ne" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="-2.0" name="ellow" type="xsd:double"/>
      <xsd:attribute default="2.0" name="elup" type="xsd:double"/>
      <xsd:attribute default="0.0" name="smearingEnergy" type="xsd:double"/>
      <xsd:attribute default="0.0" name="smearingTemperature" type="xsd:double"/>
   </xsd:complexType>

   <xsd:complexType name="EContourRectangleType">
      <xsd:attribute default="5" name="n1" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="128" name="n2" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="5" name="n3" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="5" name="nmatsub" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="0.005" name="sigma" type="xsd:double"/>
      <xsd:attribute default="-1.0" name="eb" type="xsd:double"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="EContourSemicircleType">
      <xsd:attribute default="128" name="n" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="-1.0" name="eb" type="xsd:double"/>
      <xsd:attribute default="0.0" name="et" type="xsd:double"/>
      <xsd:attribute default="1.0" name="alpha" type="xsd:double"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="EContourDOSType">
      <xsd:attribute default="1300" name="n" type="xsd:nonNegativeInteger"/>
      <xsd:attribute default="0.0314" name="sigma" type="xsd:double"/>
      <xsd:attribute default="-1.0" name="eb" type="xsd:double"/>
      <xsd:attribute default="0.0" name="et" type="xsd:double"/>
      <xsd:attribute default="T" name="analytical_cont" type="FleurBool"/>
      <xsd:attribute default="T" name="l_fermi" type="FleurBool"/>
      <xsd:attribute default="default" name="label" type="xsd:string" use="optional"/>
   </xsd:complexType>

   <xsd:complexType name="RDMFTType">
      <xsd:attribute name="l_rdmft" type="FleurBool" use="required"/>
      <xsd:attribute default="0.00001" name="occEps" type="xsd:double" use="optional"/>
      <xsd:attribute name="statesBelow" type="xsd:positiveInteger" use="required"/>
      <xsd:attribute name="statesAbove" type="xsd:positiveInteger" use="required"/>
      <xsd:attribute name="functional" type="RDMFTFunctionalEnum" use="required"/>
   </xsd:complexType>

   <xsd:complexType name="DOSOutputType">
      <xsd:annotation>
         <xsd:documentation>
            Density of states (DOS) output parameters.
            
            DOS calculation requires:
            1. Self-consistent charge density from previous SCF run
            2. output/@dos=T to enable DOS generation
            3. Appropriate energy range (minEnergy, maxEnergy) relative to Fermi level
            4. Proper broadening parameter (sigma) matched to k-point density
            
            Choosing sigma (Gaussian broadening):
            - Too small: Overly spikey DOS (artifacts from finite k-sampling)
            - Too large: Overly smooth DOS (loses physical features)
            - Depends on k-point mesh density and band dispersion
            - Typical range: 0.005-0.02 Hartree for dense k-meshes
            - Higher k-density allows smaller sigma for finer resolution
            
            Alternative: Tetrahedron method
            - Set bzIntegration/@mode="tria" for tetrahedron integration
            - Reduces k-point requirements for smooth DOS
            - Better than histogram with equivalent k-points
            - Caveat: Naive band ordering may show nonphysical gaps with small sigma
            
            Output files:
            - LOCAL.1: DOS for spin-up or non-magnetic (energy + projected DOS columns)
            - LOCAL.2: DOS for spin-down (spin-polarized calculations)
            - banddos.hdf: HDF5 format with full DOS data for advanced plotting
            
            Energy range selection:
            - Check Fermi energy: grep FermiEnergy out.xml
            - Set minEnergy, maxEnergy in Hartree relative to E_F
            - Unoccupied bands typically need higher k-density for convergence
         </xsd:documentation>
      </xsd:annotation>
      <xsd:attribute name="storeEVData" type="FleurBool" use="optional" default="T">
         <xsd:annotation>
            <xsd:documentation>Store eigenvalue data for DOS post-processing.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="all_atoms" type="FleurBool" use="optional" default="T">
         <xsd:annotation>
            <xsd:documentation>Calculate DOS for all atoms.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="orbcomp" type="FleurBool" use="optional" default="F">
         <xsd:annotation>
            <xsd:documentation>Include orbital character composition in DOS output.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="globalspin" type="FleurBool" use="optional" default="F">
         <xsd:annotation>
            <xsd:documentation>Use global spin quantization axis for DOS.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="jDOS" type="FleurBool" use="optional" default="F">
         <xsd:annotation>
            <xsd:documentation>Calculate j-resolved DOS (for spin-orbit coupling).</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="jointDOS" type="FleurBool" use="optional" default="F">
         <xsd:annotation>
            <xsd:documentation>Calculate joint DOS for optical transitions.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="minEnergy" type="FleurDouble" use="optional" default="-0.5">
         <xsd:annotation>
            <xsd:documentation>
               Minimum energy for DOS calculation, relative to Fermi level (Hartree).
               Check Fermi energy with: grep FermiEnergy out.xml
               Negative values probe occupied states.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="maxEnergy" type="FleurDouble" use="optional" default="0.5">
         <xsd:annotation>
            <xsd:documentation>
               Maximum energy for DOS calculation, relative to Fermi level (Hartree).
               Positive values probe unoccupied states (may need higher k-density).
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="sigma" type="FleurDouble" use="optional" default="0.01">
         <xsd:annotation>
            <xsd:documentation>
               Gaussian broadening width (standard deviation) in Hartree.
               
               Choice depends on k-point density:
               - Coarse k-mesh + small sigma = spikey, unphysical DOS
               - Dense k-mesh + large sigma = oversmoothed, loses features
               - Typical: 0.005-0.02 Hartree for well-converged calculations
               
               For tetrahedron method (bzIntegration/@mode="tria"), sigma still
               applies but smaller values are feasible with fewer k-points.
            </xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
      <xsd:attribute name="numberPoints" type="xsd:positiveInteger" use="optional" default="1321">
         <xsd:annotation>
            <xsd:documentation>Number of energy points in DOS spectrum.</xsd:documentation>
         </xsd:annotation>
      </xsd:attribute>
   </xsd:complexType>

   <xsd:complexType name="KPointListsType">
